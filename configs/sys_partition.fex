;---------------------------------------------------------------------------------------------------
; 说明� 脚本�的字符串区分大小写，用户�以修�"="后面的数值，但是不�修改前面的字�串
;---------------------------------------------------------------------------------------------------


;---------------------------------------------------------------------------------------------------
;                                   固件下载参数配置
;---------------------------------------------------------------------------------------------------
;***************************************************************************************************
;    mbr的大�, �Kbyte为单�
;***************************************************************************************************
[mbr]
size = 16384

;***************************************************************************************************
;                                              分区配置
;
;
;  partition 定义范例:
;    [partition]                ;  //表示���分区
;    name        = USERFS2      ; //分区名称
;    size        = 16384        ; //分区大小 单位: 扇区.分区表示�数最�2^31 * 512 = 2T
;    downloadfile = "123.fex"   ; //下载文件的路径和名称，可以使用相对路径，相�是指相对于image.cfg文件�在分区�也�以使用绝对路�
;    keydata     = 1            ; //私有数据分区，重新量产数�将不丢失
;    encrypt     = 1            ; //采用加密方式烧录，将提供数据加密，但损失烧录速度
;    user_type   = ?            ; //私有用法
;    verify      = 1            ; //要求量产完成后校验是否�确
;
; ��1、name��, 不允许同�
;     2、name��12�字�
;     3、size = 0, 将创建一�无大小的空分�
;     4、align to logical block size(504 sectors), leb size = 2*(1 nand phy block size - 1 phy page size)
;***************************************************************************************************
[partition_start]

[partition]
    name         = boot-resource
    size         = 16384
    downloadfile = "boot-resource.fex"
    user_type    = 0x8000


[partition]
    name         = env
    size         = 2048
    downloadfile = "env.fex"
    user_type    = 0x8000

[partition]
    name         = env-redund
    size         = 2048
    downloadfile = "env.fex"
    user_type    = 0x8000

[partition]
    name         = bootA
    size         = 32768
    downloadfile = "boot.fex"
    user_type    = 0x8000

[partition]
    name         = bootB
    size         = 32768
    downloadfile = "boot.fex"
    user_type    = 0x8000

[partition]
    name         = rootfsA
    size         = 7340032
    downloadfile = "rootfs.fex"
    user_type    = 0x8000

[partition]
    name         = rootfsB
    size         = 7340032
    downloadfile = "rootfs.fex"
    user_type    = 0x8000

[partition]
    name         = dsp0
    size         = 2048
    downloadfile = "dsp0.fex"
    user_type    = 0x8000

[partition]
    name         = private
    size         = 32768
    ro           = 0
    user_type    = 0x8000

[partition]
    name         = rootfs_data
    size         = 524288
    user_type    = 0x8000

[partition]
    name         = rvA
    size         = 65536
    downloadfile = "amp_rv0.fex"
    user_type    = 0x8000

[partition]
    name         = rvB
    size         = 65536
    downloadfile = "amp_rv0.fex"
    user_type    = 0x8000

[partition]
    name         = rv_data
    size         = 131072
    user_type    = 0x8000

[partition]
    name         = UDISK
    user_type    = 0x8100


