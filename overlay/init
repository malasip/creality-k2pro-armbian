#!/bin/sh
# Early init and OverlayFS manager for Creality K2 Pro
export PATH=/sbin:/usr/sbin:/bin:/usr/bin

# 1. Mount essential virtual filesystems
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /dev/shm /run /tmp /data /overlay_tmpfs /new_root /rom 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

# Load kernel modules early
modprobe overlay 2>/dev/null || true
modprobe gpio_backlight 2>/dev/null || true

# 2. Locate Partitions
DATA_DEV=""
for cand in /dev/mmcblk0p14 /dev/by-name/UDISK /dev/by-name/data; do
    if [ -b "$cand" ]; then
        DATA_DEV="$cand"
        break
    fi
done

ROOT_DEV=""
STANDBY_DEV=""
CMDLINE=$(cat /proc/cmdline 2>/dev/null)
case "$CMDLINE" in
    *root=/dev/mmcblk0p7*|*rootfsB*)
        ROOT_DEV="/dev/mmcblk0p7"
        STANDBY_DEV="/dev/mmcblk0p6"
        ;;
    *root=/dev/mmcblk0p6*|*rootfsA*)
        ROOT_DEV="/dev/mmcblk0p6"
        STANDBY_DEV="/dev/mmcblk0p7"
        ;;
    *)
        ROOT_DEV=$(sed -n 's/.*root=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)
        [ -z "$ROOT_DEV" ] && ROOT_DEV=$(findmnt -n -o SOURCE / 2>/dev/null || awk '$2 == "/" {print $1}' /proc/mounts 2>/dev/null)
        ;;
esac

EXPAND_FS_IF_NEEDED() {
    local dev="$1"
    [ -b "$dev" ] || return 0

    # Determine partition size in bytes
    local dev_bytes
    dev_bytes=$(blockdev --getsize64 "$dev" 2>/dev/null || true)
    if [ -z "$dev_bytes" ] || [ "$dev_bytes" -le 0 ]; then
        local dev_sectors
        dev_sectors=$(cat "/sys/class/block/$(basename "$dev")/size" 2>/dev/null || true)
        [ -n "$dev_sectors" ] && [ "$dev_sectors" -gt 0 ] && dev_bytes=$((dev_sectors * 512))
    fi
    [ -n "$dev_bytes" ] && [ "$dev_bytes" -gt 0 ] || return 0

    # Determine filesystem size in bytes
    local fs_bytes=0
    if [ "$dev" = "$ROOT_DEV" ] || findmnt -n -o SOURCE / 2>/dev/null | grep -q "$dev"; then
        local blocks bsize
        blocks=$(stat -f -c "%b" / 2>/dev/null || true)
        bsize=$(stat -f -c "%S" / 2>/dev/null || true)
        if [ -n "$blocks" ] && [ -n "$bsize" ] && [ "$blocks" -gt 0 ]; then
            fs_bytes=$((blocks * bsize))
        fi
    fi

    # Fallback to tune2fs if unmounted or stat unavailable
    if [ "$fs_bytes" -le 0 ]; then
        local bcount bsize
        bcount=$(tune2fs -l "$dev" 2>/dev/null | awk -F: '/Block count:/ {gsub(/ /, "", $2); print $2}')
        bsize=$(tune2fs -l "$dev" 2>/dev/null | awk -F: '/Block size:/ {gsub(/ /, "", $2); print $2}')
        if [ -n "$bcount" ] && [ -n "$bsize" ] && [ "$bcount" -gt 0 ]; then
            fs_bytes=$((bcount * bsize))
        fi
    fi

    # If filesystem is at least 64MB smaller than partition, expand it
    if [ "$fs_bytes" -gt 0 ] && [ "$fs_bytes" -lt $((dev_bytes - 67108864)) ]; then
        echo "Filesystem on ${dev} ($((fs_bytes / 1048576)) MB) is smaller than partition ($((dev_bytes / 1048576)) MB)."
        echo "Expanding filesystem to fill partition..."
        if command -v growpart >/dev/null 2>&1; then
            local disk part_num
            disk=$(echo "$dev" | sed -E 's/p?[0-9]+$//')
            part_num=$(echo "$dev" | grep -o '[0-9]*$')
            [ -b "$disk" ] && [ -n "$part_num" ] && growpart "$disk" "$part_num" 2>/dev/null || true
        fi
        resize2fs "$dev" 2>/dev/null || true
    fi
}

if [ -n "$DATA_DEV" ]; then
    # Auto-format /data partition if unformatted on first boot
    if ! blkid "$DATA_DEV" 2>/dev/null | grep -q 'TYPE="ext4"'; then
        echo "Formatting persistent /data partition ($DATA_DEV)..."
        mkfs.ext4 -F -L data "$DATA_DEV" 2>/dev/null || mke2fs -F -t ext4 -L data "$DATA_DEV" 2>/dev/null || true
    fi
    mkdir -p /data
    mount -t ext4 -o noatime,data=ordered,errors=continue "$DATA_DEV" /data 2>/dev/null || true
fi

# 3. Check for Maintenance Mode (Direct Read-Write on rootfs)
MAINTENANCE=0
CMDLINE=$(cat /proc/cmdline 2>/dev/null)
case "$CMDLINE" in
    *maintenance*|*nooverlay*|*overlay=no*|*overlay=rw*)
        MAINTENANCE=1
        ;;
esac

if [ -f /data/.maintenance_mode ]; then
    MAINTENANCE=1
fi

# First boot / First run detection:
# Check if user account first-run setup is pending on the root partition
FIRST_RUN=0
if [ -f /root/.not_logged_in_yet ]; then
    FIRST_RUN=1
elif [ ! -f /etc/.firstrun_done ]; then
    HAS_USER=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd 2>/dev/null || true)
    if [ -z "$HAS_USER" ]; then
        FIRST_RUN=1
    else
        touch /etc/.firstrun_done 2>/dev/null || true
    fi
fi

if [ "$FIRST_RUN" -eq 1 ]; then
    echo ""
    echo "======================================================="
    echo " [K2 Pro] FIRST RUN SETUP DETECTED (Direct RW Mode)    "
    echo " Root password and user configuration will be saved    "
    echo " permanently to disk. System locks into Immutable      "
    echo " mode automatically on next reboot.                   "
    echo "======================================================="
    echo ""
    MAINTENANCE=1
fi

# 4. Bring up Ethernet hardware (PE11 reset, clock, and bind)
if [ -d /sys/bus/platform/drivers/dwmac-sun8i ]; then
    devmem 0x02001970 32 0xc0000000 2>/dev/null || busybox devmem 0x02001970 32 0xc0000000 2>/dev/null || true
    if [ -d /sys/class/gpio ] && [ ! -d /sys/class/gpio/gpio139 ]; then
        echo 139 > /sys/class/gpio/export 2>/dev/null || true
    fi
    if [ -d /sys/class/gpio/gpio139 ]; then
        echo out > /sys/class/gpio/gpio139/direction 2>/dev/null || true
        echo 1 > /sys/class/gpio/gpio139/value 2>/dev/null || true
        echo 139 > /sys/class/gpio/unexport 2>/dev/null || true
    fi
    echo 4500000.ethernet > /sys/bus/platform/drivers/dwmac-sun8i/bind 2>/dev/null || true
fi

# 5. Route Boot Mode
if [ "$MAINTENANCE" -eq 1 ]; then
    echo ""
    echo "======================================================="
    echo " [K2 Pro] Booting in RW MAINTENANCE Mode (Direct Disk) "
    echo " Changes to / will be saved permanently to flash.      "
    echo " Run 'overlay-ctl lock' when finished to re-lock.        "
    echo "======================================================="
    echo ""
    mount -o remount,rw / 2>/dev/null || true

    # Expand filesystem if smaller than underlying partition
    [ -n "$ROOT_DEV" ] && EXPAND_FS_IF_NEEDED "$ROOT_DEV"
    [ -n "$STANDBY_DEV" ] && EXPAND_FS_IF_NEEDED "$STANDBY_DEV"

    # Ensure adb_shell symlink exists (/bin/adb_shell -> /usr/local/bin/adb_shell)
    if [ ! -L /bin/adb_shell ] || [ ! -e /bin/adb_shell ]; then
        [ -e /usr/local/bin/adb_shell ] && ln -sf /usr/local/bin/adb_shell /bin/adb_shell 2>/dev/null || true
    fi

    # Wire up persistent data bind mounts if /data is mounted
    if [ -n "$DATA_DEV" ]; then
        mkdir -p /data/home /data/system/NetworkManager /data/system/ssh
        [ -d /home ] && mount --bind /data/home /home
        [ -d /etc/NetworkManager/system-connections ] && mount --bind /data/system/NetworkManager /etc/NetworkManager/system-connections
        if [ -d /data/system/ssh ] && [ -d /etc/ssh ]; then
            for key in /data/system/ssh/ssh_host_*; do
                [ -f "$key" ] && cp -u "$key" /etc/ssh/ 2>/dev/null || true
            done
        fi
        touch /data/.data_initialized
    fi

    # Execute systemd
    if [ -x /lib/systemd/systemd ]; then
        exec /lib/systemd/systemd "$@"
    elif [ -x /sbin/init ]; then
        exec /sbin/init "$@"
    fi
fi

# --- NORMAL BOOT: IMMUTABLE OVERLAYFS MODE ---
echo ""
echo "=========================================================="
echo " [K2 Pro] Booting in IMMUTABLE Mode (Power-outage Safe)   "
echo " Rootfs (/) is protected. All OS writes stored in RAM.   "
echo "=========================================================="
echo ""

# Ensure physical mount points exist before remounting ro
mkdir -p /overlay_tmpfs /new_root /rom /data 2>/dev/null || true

# Expand filesystem if smaller than underlying partition before locking read-only
if [ -n "$ROOT_DEV" ]; then
    mount -o remount,rw / 2>/dev/null || true
    EXPAND_FS_IF_NEEDED "$ROOT_DEV"
    [ -n "$STANDBY_DEV" ] && EXPAND_FS_IF_NEEDED "$STANDBY_DEV"
fi

# Sync initial user accounts and credentials to Slot B if first-run finished on Slot A
if [ -b /dev/mmcblk0p7 ] && [ "$FIRST_RUN" -eq 0 ]; then
    mkdir -p /mnt_slotb
    if mount /dev/mmcblk0p7 /mnt_slotb 2>/dev/null; then
        if [ -f /mnt_slotb/root/.not_logged_in_yet ] || [ ! -f /mnt_slotb/etc/.firstrun_done ]; then
            echo "Syncing initial user accounts and credentials to Slot B..."
            EXPAND_FS_IF_NEEDED /dev/mmcblk0p7
            cp -a /etc/passwd /etc/shadow /etc/group /etc/gshadow /mnt_slotb/etc/ 2>/dev/null || true
            cp -a /etc/timezone /etc/localtime /etc/default/locale /mnt_slotb/etc/ 2>/dev/null || true
            [ -e /mnt_slotb/usr/local/bin/adb_shell ] && ln -sf /usr/local/bin/adb_shell /mnt_slotb/bin/adb_shell 2>/dev/null || true
            rm -f /mnt_slotb/root/.not_logged_in_yet 2>/dev/null || true
            touch /mnt_slotb/etc/.firstrun_done 2>/dev/null || true
            echo "Slot B credentials synchronized successfully."
        fi
        umount /mnt_slotb
    fi
    rmdir /mnt_slotb 2>/dev/null || true
fi

# Ensure physical rootfs is strictly read-only
mount -o remount,ro / 2>/dev/null || true

# Prepare OverlayFS structure
mkdir -p /overlay_tmpfs /new_root 2>/dev/null || true
mount -t tmpfs -o mode=0755 tmpfs /overlay_tmpfs
mkdir -p /overlay_tmpfs/upper /overlay_tmpfs/work

# Mount the overlay combining read-only root (lowerdir) and RAM tmpfs (upperdir)
mount -t overlay overlay -o lowerdir=/,upperdir=/overlay_tmpfs/upper,workdir=/overlay_tmpfs/work /new_root

# Prepare mount points in the new root
mkdir -p /new_root/rom /new_root/proc /new_root/sys /new_root/dev /new_root/run /new_root/data

# Mount persistent /data into new root if available
if [ -n "$DATA_DEV" ]; then
    mount -t ext4 -o noatime,data=ordered,errors=continue "$DATA_DEV" /new_root/data 2>/dev/null || true

    # Initialize persistent dirs on first run
    mkdir -p /new_root/data/home /new_root/data/system/NetworkManager /new_root/data/system/ssh
    if [ ! -f /new_root/data/.data_initialized ]; then
        echo "Initializing /data partition on first boot..."
        [ -d /home ] && cp -a /home/* /new_root/data/home/ 2>/dev/null || true
        [ -d /etc/NetworkManager/system-connections ] && cp -a /etc/NetworkManager/system-connections/* /new_root/data/system/NetworkManager/ 2>/dev/null || true
        [ -d /etc/ssh ] && cp -a /etc/ssh/ssh_host_* /new_root/data/system/ssh/ 2>/dev/null || true
        touch /new_root/data/.data_initialized
    fi

    # Wire up persistent data bind mounts
    [ -d /new_root/data/home ] && mount --bind /new_root/data/home /new_root/home
    [ -d /new_root/data/system/NetworkManager ] && mount --bind /new_root/data/system/NetworkManager /new_root/etc/NetworkManager/system-connections
    if [ -d /new_root/data/system/ssh ]; then
        for key in /new_root/data/system/ssh/ssh_host_*; do
            [ -f "$key" ] && cp -f "$key" /new_root/etc/ssh/ 2>/dev/null || true
        done
    fi
fi

# Ensure adb_shell symlink exists in new root (/bin/adb_shell -> /usr/local/bin/adb_shell)
if [ ! -L /new_root/bin/adb_shell ] || [ ! -e /new_root/bin/adb_shell ]; then
    [ -e /new_root/usr/local/bin/adb_shell ] && ln -sf /usr/local/bin/adb_shell /new_root/bin/adb_shell 2>/dev/null || true
fi

# Move API filesystems into the new root
mount --move /proc /new_root/proc
mount --move /sys /new_root/sys
mount --move /dev /new_root/dev
mount --move /run /new_root/run

# Pivot root into the immutable overlay
cd /new_root
pivot_root . rom

# Unmount the temporary /data mount in old root if still mounted
umount -l /rom/data 2>/dev/null || true

# Hand over execution to systemd in the new immutable root
if [ -x /lib/systemd/systemd ]; then
    exec /lib/systemd/systemd "$@"
elif [ -x /sbin/init ]; then
    exec /sbin/init "$@"
fi

echo "CRITICAL: Unable to execute systemd! Dropping to rescue shell..."
exec /bin/sh
